# Copy to .env (or set real environment variables). Nothing here is machine-specific.

# --- Web server -------------------------------------------------------------
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0              # never 1 on a server reachable by others
SECRET_KEY=change-me
MAX_UPLOAD_MB=200
BATCH_SIZE=8               # images per batch
SENSITIVITY=medium         # low | medium | high  (hot-spot detection threshold)

# --- Storage: pick ONE backend ------------------------------------------------
STORAGE_BACKEND=local      # local | webdav | smb

# local  (also use this for an SMB/NFS share that is already mounted on the server)
STORAGE_ROOT=data

# webdav (Nextcloud, ownCloud, Synology, Apache/nginx DAV, most NAS boxes)
# WEBDAV_URL=https://cloud.example.com/remote.php/dav/files/jon/thermal-report
# WEBDAV_USER=jon
# WEBDAV_PASSWORD=app-password-here
# WEBDAV_VERIFY_TLS=true

# smb    (connects straight to \\server\share, no OS mount needed)
# SMB_SERVER=nas.local
# SMB_SHARE=surveys
# SMB_BASE_DIR=thermal-report
# SMB_USER=jon
# SMB_PASSWORD=secret
# SMB_PORT=445
# SMB_ENCRYPT=false
