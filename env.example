# Copy to .env (or set real environment variables). Nothing here is machine-specific.

# --- Web server -------------------------------------------------------------
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0              # never 1 on a server reachable by others
SECRET_KEY=change-me
MAX_UPLOAD_MB=200
BATCH_SIZE=8               # images per batch
SENSITIVITY=medium         # default number of automatic points: lowest | low | medium | high | highest
                           #   (shown as Fewest / Fewer / Standard / More / Most; the operator can change it per
                           #   survey, on the upload page and again on the points page)
                           #   lowest >= 3.0C above the wall ... medium >= 1.3C (default) ... highest >= 0.7C
MAX_SPOTS_PER_IMAGE=8      # automatic points kept per image, strongest first (1-30)
PALETTE=inferno            # colour scale of the thermal pictures, drawn from the temperatures:
                           #   inferno (dark purple -> orange -> pale yellow, default) | cividis (blue -> yellow)
                           #   | grey (black -> white) | camera (keep the camera's own colours)
ORG_NAME=                  # printed on the report and used in its wording, e.g. Chesham Energy Group
# REPORT_CONTENT_FILE=     # optional: your own copy of report_content.json (intro text, energy-saving page, links)

# --- Storage: pick ONE backend ------------------------------------------------
STORAGE_BACKEND=local      # local | webdav | smb

# local  (also use this for an SMB/NFS share that is already mounted on the server)
STORAGE_ROOT=data

# webdav (Nextcloud, ownCloud, Synology, Apache/nginx DAV, most NAS boxes)
# WEBDAV_URL=https://cloud.example.com/remote.php/dav/files/jon/thermal-report
# WEBDAV_USER=jon
# WEBDAV_PASSWORD=app-password-here
# WEBDAV_VERIFY_TLS=true

# smb    (connects straight to \\server\share, no OS mount needed)
# SMB_SERVER=nas.local
# SMB_SHARE=surveys
# SMB_BASE_DIR=thermal-report
# SMB_USER=jon
# SMB_PASSWORD=secret
# SMB_PORT=445
# SMB_ENCRYPT=false

# --- Wake-on-LAN for a sleeping NAS (optional; everything below stays off until MAC and host are set)
# Enable "WOL on LAN 1" in DSM first (Control Panel > Hardware & Power). Works on the same network only.
# WAKE_MAC=AA:BB:CC:DD:EE:FF          # the NAS's MAC address (DSM: Control Panel > Info Center > Network)
# WAKE_BROADCAST=192.168.1.255        # your network's broadcast address; leave blank to use 255.255.255.255
# NAS_HOST=192.168.1.50               # the NAS's address, used to see when it has woken up
# NAS_PORT=445                        # 445 = SMB
# NAS_MARKER=.thermal-report-share    # file that must exist on the share, so an unmounted share is never mistaken for it

# --- Several groups on one installation (optional; leave unset for the single-group setup)
# 1. cp -r orgs.example orgs   and edit orgs/orgs.json: each group's name, colour and members' emails
# 2. set a long random SECRET_KEY above (required), then:
# ORGS_FILE=orgs/orgs.json
# AUTH_MODE=cloudflare                                   # check Cloudflare Access's signed token on every request
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com    # Zero Trust > Settings > Custom pages / team domain
# CF_ACCESS_AUD=                                         # Access > Applications > your app > Overview > Audience tag
# AUTH_MODE=dev                                          # trying it on your own machine only: everyone is DEV_USER_EMAIL
# DEV_USER_EMAIL=you@example.org
