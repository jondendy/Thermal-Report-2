# Copy to .env (or set real environment variables). Nothing here is machine-specific.

# --- Web server -------------------------------------------------------------
HOST=0.0.0.0
PORT=5000
# never 1 on a server reachable by others
FLASK_DEBUG=0
SECRET_KEY=change-me
MAX_UPLOAD_MB=200
# images per batch
BATCH_SIZE=8
# default number of automatic points: lowest | low | medium | high | highest
# (shown as Fewest / Fewer / Standard / More / Most; the operator can change it per
# survey, on the upload page and again on the points page)
# lowest >= 3.0C above the wall ... medium >= 1.3C (default) ... highest >= 0.7C
SENSITIVITY=medium
# automatic points kept per image, strongest first (1-30)
MAX_SPOTS_PER_IMAGE=8
# colour scale of the thermal pictures, drawn from the temperatures:
# inferno (dark purple -> orange -> pale yellow, default) | ironbow (black -> blue -> magenta -> orange -> white)
# | cividis (blue -> yellow) | grey (black -> white) | camera (keep the camera's own colours).
# This is only the starting style: each batch can be switched on its points page.
PALETTE=inferno
# printed on the report and used in its wording, e.g. Chesham Energy Group
ORG_NAME=
# a red bar across the top of every page, for a test site (not printed on reports); blank = none
# BANNER_TEXT=TEST SITE
# optional: your own copy of report_content.json (intro text, energy-saving page, links)
# REPORT_CONTENT_FILE=

# --- Storage: pick ONE backend ------------------------------------------------
# local | webdav | smb
STORAGE_BACKEND=local

# local  (also use this for an SMB/NFS share that is already mounted on the server)
STORAGE_ROOT=data

# webdav (Nextcloud, ownCloud, Synology, Apache/nginx DAV, most NAS boxes)
# WEBDAV_URL=https://cloud.example.com/remote.php/dav/files/jon/thermal-report
# WEBDAV_USER=jon
# WEBDAV_PASSWORD=app-password-here
# WEBDAV_VERIFY_TLS=true

# smb    (connects straight to \\server\share, no OS mount needed)
# SMB_SERVER=nas.local
# SMB_SHARE=surveys
# SMB_BASE_DIR=thermal-report
# SMB_USER=jon
# SMB_PASSWORD=secret
# SMB_PORT=445
# SMB_ENCRYPT=false

# --- Wake-on-LAN for a sleeping NAS (optional; everything below stays off until MAC and host are set)
# Enable "WOL on LAN 1" in DSM first (Control Panel > Hardware & Power). Works on the same network only.
# the NAS's MAC address (DSM: Control Panel > Info Center > Network)
# WAKE_MAC=AA:BB:CC:DD:EE:FF
# your network's broadcast address; leave blank to use 255.255.255.255
# WAKE_BROADCAST=192.168.1.255
# the NAS's address, used to see when it has woken up
# NAS_HOST=192.168.1.50
# 445 = SMB
# NAS_PORT=445
# file that must exist on the share, so an unmounted share is never mistaken for it
# NAS_MARKER=.thermal-report-share

# --- Several groups on one installation (optional; leave unset for the single-group setup)
# 1. cp -r orgs.example orgs   and edit orgs/orgs.json: each group's name, colour and members' emails
# 2. set a long random SECRET_KEY above (required), then:
# ORGS_FILE=orgs/orgs.json
# check Cloudflare Access's signed token on every request
# AUTH_MODE=cloudflare
# Zero Trust > Settings > Custom pages / team domain
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# Access > Applications > your app > Overview > Audience tag
# CF_ACCESS_AUD=
# trying it on your own machine only: everyone is DEV_USER_EMAIL
# AUTH_MODE=dev
# DEV_USER_EMAIL=you@example.org

# ---- The drive: "Upload to drive" / "Select from drive" buttons (optional)
# Folder where pictures are parked, e.g. a Synology share mounted on the server. Each group
# gets its own sub-folder. Leave empty and the buttons do not appear.
# INBOX_ROOT=/mnt/synology/thermal-inbox
# A file that exists on the share (create it once). If it is missing the share is treated as not mounted,
# so nothing is ever written to the bare mount point. Also used by the Wake-on-LAN check.
# NAS_MARKER=.thermal-mounted
# true = remove a picture from the drive once a batch has been made from it
# INBOX_DELETE_AFTER_PROCESS=false
# cleanup_inbox.py deletes pictures older than this many days
# INBOX_KEEP_DAYS=30
# most pictures one group may keep on the drive
# INBOX_MAX_FILES=500
